{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "jsx": "preserve",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "static/ui/src/**/*.ts",
    "static/ui/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "static/ui/build", "static/ui/node_modules"]
}

